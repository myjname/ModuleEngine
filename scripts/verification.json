{
  "schema_version": 1,
  "protected": ["*.json", "assets", "game-assets", ".user", ".history", ".asset-history", ".asset-trash"],
  "profiles": {
    "clippy": {"steps": ["clippy"], "scope": "Strict Clippy for the pinned native Rust toolchain, all workspace targets and features; no tests, formatting or runtime acceptance."},
    "quick": {"steps": ["fmt", "core", "project"], "scope": "Formatting and CPU Core/Project library tests; not a workspace or native acceptance."},
    "contracts": {"steps": ["fmt", "core", "project", "cargo-products", "inspector-prefab", "inspector-opaque", "inspector-noop", "inspector-prefix", "inspector-generated-noop", "inspector-generated-inheritance", "inspector-generated-controls", "save-as-boundaries", "preservation-save-as", "preservation-replay-rollback", "preservation-history-branch", "diagnostic-personal-paths"], "scope": "Selected author-data and artifact-selection regressions: 99 bounded Inspector Apply scenarios, Save As boundary tests, 28 bounded workflow preservation scenarios and diagnostic personal-path isolation; no native ignored tests."},
    "native": {"steps": ["native-reuse", "native-slow-ui", "native-linker", "native-context", "native-exe-spellings"], "scope": "Five explicit native ignored tests; not desktop/performance or full workspace acceptance."},
    "native-tools": {"steps": ["native-linker", "native-context", "native-exe-spellings"], "scope": "Installed native linker and audited compile context, plus Windows executable spellings; no GPU, UI or timing acceptance."},
    "package": {"steps": ["package-target-modes", "package-snapshots"], "scope": "Two native Cargo fixture product/snapshot tests; not Full/Team/Player game export, relocation or delivery acceptance."}
  },
  "legacy_routes": {"performance": {"command": "verify.ps1 -NativeBenchmarks", "scope": "Existing full legacy suite followed by opt-in native benchmarks; not a strict 60 FPS certification. See docs/verification.md for fixture and environment limitations."}},
  "steps": [
    {"id": "clippy", "kind": "command", "argv": ["cargo", "clippy", "--offline", "--locked", "--target", "{native_host}", "--workspace", "--all-targets", "--all-features", "--", "-D", "warnings"], "pinned_rust": true, "timeout": 1200, "purpose": "Reject all Clippy warnings in every workspace target with all additive features on the pinned native toolchain."},
    {"id": "fmt", "kind": "command", "argv": ["cargo", "fmt", "--all", "--", "--check"], "timeout": 120, "purpose": "Check Rust formatting without rewriting files."},
    {"id": "diagnostic-personal-paths", "kind": "tests", "package": "module-engine-editor", "target_kind": "bin", "filter": "diagnostic_personal", "timeout": 180, "purpose": "Explicit diagnostic paths isolate Recent/layout, reject invalid roots, and preserve distribution/source permissions and authored data."},
    {"id": "core", "kind": "tests", "package": "module-engine-core", "target_kind": "lib", "filter": "", "timeout": 300, "purpose": "CPU Core contracts."},
    {"id": "project", "kind": "tests", "package": "module-engine-project", "target_kind": "lib", "filter": "", "timeout": 300, "purpose": "CPU Project data, history and asset contracts."},
    {"id": "cargo-products", "kind": "tests", "package": "module-engine-script", "target_kind": "lib", "filter": "cargo_build::tests::", "timeout": 300, "purpose": "Existing production Cargo artifact collector regressions."},
    {"id": "inspector-prefab", "kind": "tests", "package": "module-engine-editor", "target_kind": "bin", "filter": "game_ui::tests::inspector_apply_preserves_partial_prefab_aggregates_and_effective_defaults_after_save", "exact": true, "timeout": 180, "purpose": "Partial prefab aggregates and effective defaults after save."},
    {"id": "inspector-opaque", "kind": "tests", "package": "module-engine-editor", "target_kind": "bin", "filter": "game_ui::tests::inspector_apply_preserves_exact_opaque_members_after_save", "exact": true, "timeout": 180, "purpose": "Literal/opaque JSON members after Inspector Apply."},
    {"id": "inspector-noop", "kind": "tests", "package": "module-engine-editor", "target_kind": "bin", "filter": "game_ui::tests::inspector_unchanged_owner_collision_preserves_prefab_inheritance_after_save", "exact": true, "timeout": 180, "purpose": "Unchanged Apply preserves prefab inheritance."},
    {"id": "inspector-prefix", "kind": "tests", "package": "module-engine-editor", "target_kind": "bin", "filter": "game_ui::tests::inspector_apply_and_inherit_preserve_longer_component_owners_after_save", "exact": true, "timeout": 180, "purpose": "Longer component owners remain distinct."},
    {"id": "inspector-generated-noop", "kind": "tests", "package": "module-engine-editor", "target_kind": "bin", "filter": "game_ui::tests::inspector_generated_noop_apply_preserves_authored_json_after_save", "exact": true, "timeout": 180, "purpose": "48 bounded key/value cases: real no-op Apply and save/reopen preserve authored opaque members."},
    {"id": "inspector-generated-inheritance", "kind": "tests", "package": "module-engine-editor", "target_kind": "bin", "filter": "game_ui::tests::inspector_generated_noop_apply_keeps_future_prefab_inheritance_after_save", "exact": true, "timeout": 180, "purpose": "48 bounded key/value cases: no-op Apply keeps future prefab/default inheritance."},
    {"id": "inspector-generated-controls", "kind": "tests", "package": "module-engine-editor", "target_kind": "bin", "filter": "game_ui::tests::inspector_generated_apply_positive_controls_keep_intentional_local_values", "exact": true, "timeout": 180, "purpose": "Three positive controls: actual registered edits, existing overrides and intentional opaque local edits."},
    {"id": "save-as-boundaries", "kind": "tests", "package": "module-engine-editor", "target_kind": "bin", "filter": "editor_workflow::workflow_tests::save_as_", "timeout": 180, "purpose": "Existing Save As Cancel/picker/publication failure, same-path, copy and invalid JSON boundaries."},
    {"id": "preservation-save-as", "kind": "tests", "package": "module-engine-editor", "target_kind": "bin", "filter": "app::editor_workflow::workflow_tests::preservation_save_as_matrix_keeps_source_and_opaque_drafts_on_cancel_conflict_and_copy", "exact": true, "timeout": 300, "purpose": "18 bounded cases: real Save As Cancel/conflict/copy preserves opaque drafts, source bytes, stable asset ID and binding."},
    {"id": "preservation-replay-rollback", "kind": "tests", "package": "module-engine-editor", "target_kind": "bin", "filter": "app::editor_workflow::workflow_tests::preservation_asset_replay_failed_json_publish_rolls_back_undo_and_redo", "exact": true, "timeout": 180, "purpose": "Four Rename/Delete Undo/Redo failures preserve filesystem/history, explicitly account for recovery JSON, and allow retry."},
    {"id": "preservation-history-branch", "kind": "tests", "package": "module-engine-editor", "target_kind": "bin", "filter": "app::editor_workflow::workflow_tests::preservation_asset_branch_keeps_ids_bytes_and_opaque_payload_after_move_delete_undo_redo", "exact": true, "timeout": 300, "purpose": "Six branched history cases preserve stable IDs, exact payload and binary bytes without replaying a discarded branch."},
    {"id": "native-reuse", "kind": "tests", "package": "module-engine-editor", "target_kind": "bin", "filter": "game_ui::tests::scene_and_game_reuse_code_after_stop_with_independent_initial_state_and_workers", "exact": true, "ignored": true, "release": true, "timeout": 600, "resources": ["sharedGPU", "nativeToolchain"], "purpose": "Normal-loader Stop/reuse, independent state and workers."},
    {"id": "native-slow-ui", "kind": "tests", "package": "module-engine-editor", "target_kind": "bin", "filter": "game_ui::tests::interactive_game_ui_keeps_drawing_and_applying_rust_during_slow_ticks", "exact": true, "ignored": true, "release": true, "timeout": 600, "resources": ["sharedGPU", "nativeToolchain"], "purpose": "Explicit latency acceptance without competing Rust/GPU setup."},
    {"id": "native-linker", "kind": "tests", "package": "module-engine-script", "target_kind": "lib", "filter": "native_tools::tests::native_host_resolver_matches_actual_rustc_linker", "exact": true, "ignored": true, "release": true, "timeout": 300, "resources": ["nativeToolchain"], "purpose": "Installed native Rust/linker resolution."},
    {"id": "native-context", "kind": "tests", "package": "module-engine-script", "target_kind": "lib", "filter": "cache_context::tests::actual_supported_native_context_is_cacheable", "exact": true, "ignored": true, "release": true, "timeout": 600, "resources": ["nativeToolchain"], "purpose": "Actual audited native compile-context proof."},
    {"id": "native-exe-spellings", "kind": "tests", "package": "module-engine-script", "target_kind": "lib", "filter": "cache_context::tests::actual_windows_exe_tool_names_compile_with_and_without_store", "exact": true, "ignored": true, "release": true, "platforms": ["windows"], "timeout": 1200, "resources": ["nativeToolchain"], "purpose": "Windows bare/suffixed/absolute Cargo/Rustc spellings, stored and uncached."},
    {"id": "package-target-modes", "kind": "tests", "package": "module-engine-editor", "target_kind": "bin", "filter": "game_package::tests::native_player_target_modes_use_actual_artifacts", "exact": true, "ignored": true, "release": true, "timeout": 1200, "resources": ["nativeToolchain"], "purpose": "Minimal native Cargo fixture: default/env/config/foreign target, cold/warm/fresh products; not game export."},
    {"id": "package-snapshots", "kind": "tests", "package": "module-engine-editor", "target_kind": "bin", "filter": "game_package::tests::concurrent_native_player_variants_keep_immutable_snapshots", "exact": true, "ignored": true, "release": true, "timeout": 1200, "resources": ["nativeToolchain"], "purpose": "Minimal Cargo fixture: concurrent feature variants and immutable snapshots; not delivery acceptance."},
    {"id": "fixture-emitter", "kind": "tests", "package": "module-engine-editor", "target_kind": "bin", "filter": "runtime_delivery::tests::emit_stage4_software_inactive_vulkan_fixture", "exact": true, "ignored": true, "excluded": true, "purpose": "Fixture preparation only: requires a new absolute MODULE_ENGINE_STAGE4_FIXTURE_PATH; never a product acceptance."},
    {"id": "catchup-diagnostic", "kind": "tests", "package": "module-engine-host", "target_kind": "lib", "filter": "compat_tests::audit_slow_custom_catchup_wall_time", "exact": true, "ignored": true, "excluded": true, "purpose": "Historical wall-time diagnostic; excluded from normal profiles and performance gates."}
  ]
}
